# Copy values from this template into your shell profile, automation runner, or
# local .env file if you use a dotenv loader. Do not commit real secrets.

# Notifications: pushplus, email, webhook, or none.
XUEQIU_NOTIFY=pushplus
XUEQIU_PUSHPLUS_TOKEN=replace-with-your-pushplus-token

# Optional PushPlus routing.
# XUEQIU_PUSHPLUS_TOPIC=
# XUEQIU_PUSHPLUS_CHANNEL=
# XUEQIU_PUSHPLUS_WEBHOOK=

# Optional notification timeout in seconds.
XUEQIU_NOTIFY_TIMEOUT=15

# SMTP email alternative.
# XUEQIU_NOTIFY=email
# XUEQIU_EMAIL_HOST=smtp.example.com
# XUEQIU_EMAIL_PORT=587
# XUEQIU_EMAIL_SECURITY=starttls
# XUEQIU_EMAIL_USER=you@example.com
# XUEQIU_EMAIL_PASSWORD=replace-with-your-password
# XUEQIU_EMAIL_TO=you@example.com
# XUEQIU_EMAIL_FROM=you@example.com

# Generic JSON webhook alternative.
# XUEQIU_NOTIFY=webhook
# XUEQIU_WEBHOOK_URL=https://example.com/webhook
